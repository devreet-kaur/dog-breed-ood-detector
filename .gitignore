# ══════════════════════════════════════════════════════
# dog-breed-ood-detector .gitignore
# Finalized day 1 -- never change after PR #2 merges.
# ══════════════════════════════════════════════════════

# ── Data -- DVC tracked, never in Git ────────────────
# The negations matter: `data/` alone also hides the .dvc pointer files, which
# are the one thing under data/ that MUST be committed. Without them
# `dvc add data/raw/stanford_dogs` produces a file git silently refuses to stage.
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitignore
*.csv
*.json.gz

# ── Models -- DVC outputs, never in Git ──────────────
models/*
*.pt
*.pth
*.pkl
*.onnx
*.bin
*.safetensors

# ── DVC pipeline outputs ──────────────────────────────
reports/plots/*
reports/ood/
reports/drift/

# ── MLflow -- machine specific, never commit ──────────
mlruns/
mlflow.db
*.db

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg
MANIFEST

# ── Environments ──────────────────────────────────────
.env
.env.*
.venv
venv/
env/
ENV/
env.bak/
venv.bak/
*.env

# ── Credentials -- never commit ───────────────────────
.secrets/
*service-account*.json
*credentials*.json

# ── Local scratch (never commit) ─────────────────────
check.py
scratch*.py
tmp*.py
*_scratch.py
*token*.txt
secrets.*

# ── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ── macOS ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── Windows ───────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
.spyderproject.cfg
.spyproject
.ropeproject
*.sublime-workspace

# ── Docker ────────────────────────────────────────────
.docker/

# ── DVC local credentials -- NEVER commit ─────────────
.dvc/config.local
.dvc/tmp/

# ── HuggingFace cache ─────────────────────────────────
.cache/
~/.cache/huggingface/

# ── Logs ──────────────────────────────────────────────
*.log
logs/
inference_logs/

# ── Coverage ──────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
!models/temperature.json
!.env.example
!.env.example
!reports/plots/confusion_matrix.png
